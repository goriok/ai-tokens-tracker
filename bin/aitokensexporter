#!/bin/bash
# Runs a one-time backfill (idempotent: no-op if already completed, unless
# --force) then serves /metrics continuously. See docs/madrs/MADR-003.
set -e
source "$(dirname "$(readlink -f "$0")")/_resolve.sh"
TSDB_DIR="${AITOKENS_TSDB_DIR:-$HOME/.local/share/ai-tokens-tracker/tsdb}"

if [ ! -f "$TSDB_DIR/ingest_state.json" ] || ! grep -q backfill_completed_at "$TSDB_DIR/ingest_state.json" 2>/dev/null; then
  $AITOKENS_EXPORTER_BIN backfill --tsdb "$TSDB_DIR"
fi

exec $AITOKENS_EXPORTER_BIN serve --tsdb "$TSDB_DIR" "$@"
