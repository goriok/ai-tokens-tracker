[Unit]
Description=ai-tokens-tracker — VictoriaMetrics single-node (local, scrapes the exporter)
After=network.target ai-tokens-exporter.service
Wants=ai-tokens-exporter.service

[Service]
Type=simple
ExecStart=%h/.local/bin/victoria-metrics \
  -storageDataPath=%h/.local/share/ai-tokens-tracker/vm-data \
  -promscrape.config=%h/sources/goriok/ai-token-tracker/systemd/vm-scrape.yaml \
  -httpListenAddr=127.0.0.1:8428 \
  -retentionPeriod=100y
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
